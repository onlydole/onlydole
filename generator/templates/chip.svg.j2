<svg xmlns="http://www.w3.org/2000/svg" width="320" height="80" viewBox="0 0 160 40" role="img" aria-label="{{ label }}">
  <rect x="1" y="1" width="158" height="38" rx="7" fill="{{ theme.bg }}" stroke="{{ theme.border }}"/>
  <circle cx="18" cy="20" r="7" fill="{{ theme.accent }}" fill-opacity="0.18" stroke="{{ theme.accent }}"/>
  <text x="88" y="25" text-anchor="middle" font-family="{{ font }}" font-size="14" font-weight="600" fill="{{ theme.text }}">{{ label }} <tspan fill="{{ theme.accent }}">↗</tspan></text>
</svg>
