<svg xmlns="http://www.w3.org/2000/svg" width="600" height="520" viewBox="0 0 600 520" role="img" aria-label="{{ aria }}">
  <title>{{ aria }}</title>
  <defs>
    <linearGradient id="paper" x2="1" y2="1"><stop stop-color="#fffaf1"/><stop offset="0.6" stop-color="#f8eee1"/><stop offset="1" stop-color="#eedcca"/></linearGradient>
    <pattern id="paper-fibers" width="24" height="22" patternUnits="userSpaceOnUse"><circle cx="3" cy="4" r="0.9" fill="#654d42" fill-opacity="0.1"/><circle cx="18" cy="15" r="0.7" fill="#b66c54" fill-opacity="0.08"/><path d="M8 18 l5 -1 M1 11 l4 0.5" stroke="#654d42" stroke-opacity="0.065"/></pattern>
    <clipPath id="frame"><rect width="600" height="520" rx="18"/></clipPath>
  </defs>
  <g clip-path="url(#frame)">
    <rect width="600" height="520" fill="url(#paper)"/>
    <rect width="600" height="520" fill="url(#paper-fibers)"/>

    <text x="29" y="40" font-family="{{ sans }}" font-size="13" font-weight="700" letter-spacing="3.4" fill="#944634">OPEN SOURCE  /  LOS ANGELES</text>
    <path d="M29 55 H99" stroke="#bd6750" stroke-width="2"/>
    <text x="27" y="114" font-family="{{ serif }}" font-size="50" font-weight="700" fill="#281f1b">{{ name }}</text>
    <text x="29" y="154" font-family="{{ serif }}" font-size="24" font-weight="700" fill="#3a2d28">{{ role }}</text>

    <text x="29" y="204" font-family="{{ serif }}" font-size="23" fill="#3f312b">Building open source communities,</text>
    <text x="29" y="234" font-family="{{ serif }}" font-size="23" fill="#3f312b">making useful things, and sharing</text>
    <text x="29" y="264" font-family="{{ serif }}" font-size="23" fill="#3f312b">what I learn.</text>

    <text x="29" y="307" font-family="{{ sans }}" font-size="13" fill="#655248">Disney Studios  →  HashiCorp  →  CNCF  →  Dosu</text>
    <text x="29" y="337" font-family="{{ sans }}" font-size="12" font-weight="700" letter-spacing="0.8" fill="#655248">KUBERNETES 1.19 LEAD  /  KEYNOTER  /  AUTHOR</text>
    <path d="M29 372 H306" stroke="#8c7165" stroke-opacity="0.52"/>
    <text x="31" y="414" font-family="{{ serif }}" font-size="19" font-style="italic" fill="#7b4639">The project is code.</text>
    <text x="31" y="440" font-family="{{ serif }}" font-size="19" font-style="italic" fill="#7b4639">The work is people.</text>
    <path d="M30 451 Q154 458 278 449" fill="none" stroke="#b76650" stroke-opacity="0.58"/>

    <image x="278" y="260" width="314" height="258" opacity="0.92" preserveAspectRatio="xMaxYMid meet" href="data:image/png;base64,{{ illustration_b64 }}"/>
  </g>
  <rect x="1" y="1" width="598" height="518" rx="17" fill="none" stroke="#d5c0ae" stroke-width="2"/>
</svg>
