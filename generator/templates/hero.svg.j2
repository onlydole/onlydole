<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="430" viewBox="0 0 1200 430" role="img" aria-label="{{ aria }}">
  <title>{{ aria }}</title>
  <defs>
    <linearGradient id="paper" x2="1" y2="1">
      <stop stop-color="#fffaf1"/>
      <stop offset="0.58" stop-color="#f8eee1"/>
      <stop offset="1" stop-color="#eedcca"/>
    </linearGradient>
    <pattern id="paper-fibers" width="26" height="24" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="4" r="0.9" fill="#654d42" fill-opacity="0.1"/>
      <circle cx="19" cy="17" r="0.7" fill="#b66c54" fill-opacity="0.09"/>
      <path d="M7 20 l6 -1 M18 5 l4 1 M1 12 l4 0.5" stroke="#654d42" stroke-opacity="0.07"/>
    </pattern>
    <filter id="grain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.72" numOctaves="3" seed="11" result="noise"/>
      <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.32  0 0 0 0 0.24  0 0 0 0 0.2  0 0 0 0.11 0"/>
    </filter>
    <clipPath id="frame"><rect width="1200" height="430" rx="18"/></clipPath>
  </defs>
  <g clip-path="url(#frame)">
    <rect width="1200" height="430" fill="url(#paper)"/>
    <rect width="1200" height="430" fill="url(#paper-fibers)"/>
    <rect width="1200" height="430" filter="url(#grain)" opacity="0.24"/>

    <text x="49" y="48" font-family="{{ sans }}" font-size="14" font-weight="700" letter-spacing="4.8" fill="#944634">OPEN SOURCE  /  LOS ANGELES</text>
    <path d="M49 64 H138" stroke="#bd6750" stroke-width="2"/>
    <text x="45" y="137" font-family="{{ serif }}" font-size="72" font-weight="700" fill="#281f1b">{{ name }}</text>
    <text x="49" y="182" font-family="{{ serif }}" font-size="29" font-weight="700" fill="#3a2d28">{{ role }}</text>

    <text x="49" y="231" font-family="{{ serif }}" font-size="24" fill="#3f312b">Building open source communities, making useful things,</text>
    <text x="49" y="261" font-family="{{ serif }}" font-size="24" fill="#3f312b">and sharing what I learn.</text>

    <text x="49" y="306" font-family="{{ sans }}" font-size="15" fill="#655248">Formerly Disney Studios SRE, HashiCorp, and CNCF Head of Ecosystem.</text>
    <text x="49" y="335" font-family="{{ sans }}" font-size="15" fill="#655248">Kubernetes 1.19 release lead · KubeCon keynoter · technical author.</text>

    <path d="M49 363 H752" stroke="#8c7165" stroke-opacity="0.52"/>
    <g transform="rotate(-1 52 396)">
      <text x="52" y="399" font-family="{{ serif }}" font-size="21" font-style="italic" fill="#7b4639">The project is code. The work is people.</text>
      <path d="M51 409 Q235 416 419 406" fill="none" stroke="#b76650" stroke-opacity="0.58"/>
    </g>

    <image x="688" y="3" width="500" height="424" preserveAspectRatio="xMaxYMid meet" href="data:image/png;base64,{{ illustration_b64 }}"/>
  </g>
  <rect x="1" y="1" width="1198" height="428" rx="17" fill="none" stroke="#d5c0ae" stroke-width="2"/>
</svg>
