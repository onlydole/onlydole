<svg xmlns="http://www.w3.org/2000/svg" width="{{ width }}" height="{{ height }}" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ aria }}">
  <title>{{ aria }}</title>
  <defs>
    <linearGradient id="wash" x2="1">
      <stop stop-color="{{ theme.accent }}" stop-opacity="0.25"/>
      <stop offset="0.72" stop-color="{{ theme.bg }}" stop-opacity="0.02"/>
    </linearGradient>
    <pattern id="fibers" width="24" height="22" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="5" r="0.8" fill="{{ theme.text }}" fill-opacity="0.07"/>
      <circle cx="19" cy="16" r="0.7" fill="{{ theme.accent }}" fill-opacity="0.09"/>
      <path d="M8 19 l6 -1 M1 11 l4 0.5" stroke="{{ theme.text }}" stroke-opacity="0.055"/>
    </pattern>
  </defs>
  <rect x="1" y="1" width="{{ width - 2 }}" height="{{ height - 2 }}" rx="8" fill="{{ theme.bg }}" stroke="{{ theme.accent }}" stroke-opacity="0.4" stroke-width="2"/>
  <rect x="2" y="2" width="{{ width - 4 }}" height="{{ height - 4 }}" rx="7" fill="url(#wash)"/>
  <rect x="2" y="2" width="{{ width - 4 }}" height="{{ height - 4 }}" rx="7" fill="url(#fibers)"/>
{% if cover %}
  <rect x="{{ 12 if width <= 600 else 29 }}" y="{{ 12 if width <= 600 else 18 }}" width="{{ 60 if width <= 600 else 108 }}" height="{{ 72 if width <= 600 else 140 }}" rx="6" fill="{{ theme.accent }}" fill-opacity="0.14" stroke="{{ theme.accent }}" stroke-opacity="0.35"/>
  <image x="{{ 16 if width <= 600 else 36 }}" y="{{ 15 if width <= 600 else 24 }}" width="{{ 52 if width <= 600 else 94 }}" height="{{ 66 if width <= 600 else 128 }}" preserveAspectRatio="xMidYMid meet" href="data:{{ cover.mime }};base64,{{ cover.b64 }}"/>
{% else %}
  <rect x="{{ 12 if width <= 600 else 28 }}" y="{{ 12 if width <= 600 else 26 }}" width="{{ 60 if width <= 600 else 108 }}" height="{{ 72 if width <= 600 else 124 }}" rx="6" fill="{{ theme.accent }}" fill-opacity="0.12" stroke="{{ theme.accent }}" stroke-opacity="0.28"/>
  <g transform="translate({{ 42 if width <= 600 else 82 }} {{ 48 if width <= 600 else 88 }}){% if width <= 600 %} scale(0.72){% endif %}" fill="none" stroke="{{ theme.accent }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
{% if key == "writing" %}
    <path d="M-20 -28 H12 L24 -16 V29 H-20Z M12 -28 V-16 H24 M-10 -5 H13 M-10 7 H13 M-10 19 H5"/>
{% elif key == "podcast" %}
    <path d="M-25 6 V-3 A25 25 0 0 1 25 -3 V6 M-25 6 V24 H-13 V4 H-25 M25 6 V24 H13 V4 H25"/>
{% elif key == "shipped" %}
    <path d="M0 -28 L25 -14 V15 L0 29 L-25 15 V-14Z M-25 -14 L0 1 L25 -14 M0 1 V29"/>
{% elif key == "stage" %}
    <path d="M-12 -27 H12 V5 A12 12 0 0 1 -12 5Z M-23 1 V7 A23 23 0 0 0 23 7 V1 M0 30 V19 M-12 30 H12"/>
{% else %}
    <path d="M0 -24 C-10 -31 -22 -30 -28 -24 V20 C-18 15 -9 16 0 23 C9 16 18 15 28 20 V-24 C22 -30 10 -31 0 -24Z M0 -24 V23"/>
{% endif %}
  </g>
{% endif %}
  <path d="M{{ 82 if width <= 600 else 150 }} {{ 12 if width <= 600 else 24 }} V{{ height - (12 if width <= 600 else 24) }}" stroke="{{ theme.accent }}" stroke-opacity="0.36"/>
  <text x="{{ text_x }}" y="{{ 24 if width <= 600 else 42 }}" font-family="{{ sans }}" font-size="{{ 20 if width <= 600 else 15 }}" font-weight="700" letter-spacing="{{ 1 if width <= 600 else 2.6 }}" fill="{{ theme.accent }}">{{ header }}</text>
{% for text in featured.primary %}
  <text x="{{ text_x }}" y="{{ (54 if width <= 600 else 83) + loop.index0 * 31 }}" font-family="{{ serif }}" font-size="29" font-weight="700" fill="{{ theme.text }}">{{ text }}</text>
{% endfor %}
  <text x="{{ text_x }}" y="{{ 82 if width <= 600 else 83 + featured.primary|length * 31 + 9 }}" font-family="{{ sans }}" font-size="{{ 20 if width <= 600 else 17 }}" letter-spacing="{{ 0.2 if width <= 600 else 0.6 }}" fill="{{ theme.muted }}">{{ featured.secondary }}</text>
{% if width > 600 %}
  <text x="1018" y="76" font-family="{{ sans }}" font-size="16" font-weight="700" letter-spacing="2.3" fill="{{ theme.accent }}">{{ action }}</text>
  <path d="M1125 86 H1162 M1151 75 L1162 86 L1151 97" fill="none" stroke="{{ theme.accent }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
{% endif %}
</svg>
