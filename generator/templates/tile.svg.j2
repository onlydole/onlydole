{%- set m = layout.motion -%}
{%- set cycle = m.cycle ~ 's' -%}
{%- set enter = 'draw .9s cubic-bezier(.65, 0, .35, 1) ' ~ m.enter ~ 's backwards' -%}
{%- set land = 'pop .4s cubic-bezier(.3, .7, .4, 1) ' ~ (m.enter + 0.7) ~ 's backwards' -%}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ layout.width }}" height="{{ layout.height }}" viewBox="0 0 {{ layout.width }} {{ layout.height }}" role="img" aria-label="{{ aria }}">
  <title>{{ aria }}</title>
  <style>
    .icon { fill: none; stroke: {{ theme.accent }}; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
    .fit { transform-box: fill-box; transform-origin: center; }
    @keyframes draw { from { stroke-dasharray: 1 1.1; stroke-dashoffset: 1.1; } to { stroke-dasharray: 1 1.1; stroke-dashoffset: 0; } }
    @keyframes write { 0% { stroke-dasharray: 1 1.1; stroke-dashoffset: 1.1; } 7%, 100% { stroke-dasharray: 1 1.1; stroke-dashoffset: 0; } }
    @keyframes pop { from { transform: scale(0); } 70% { transform: scale(1.3); } to { transform: scale(1); } }
    @keyframes beat { 0%, 9%, 100% { transform: scale(1); } 4% { transform: scale(1.5); } }
    @keyframes ring { 0% { opacity: .6; transform: scale(1); } 9%, 100% { opacity: 0; transform: scale(2.6); } }
    @keyframes talk { 0%, 13%, 100% { transform: scaleY(1); } 2% { transform: scaleY(1.7); } 4% { transform: scaleY(.45); } 6% { transform: scaleY(1.45); } 8% { transform: scaleY(.7); } 10.5% { transform: scaleY(1.25); } }
    @keyframes wave-l { 0%, 100% { opacity: 0; transform: none; } 3%, 9% { opacity: .9; } 6%, 12% { opacity: 0; transform: translateX(-7px); } 6.01% { transform: none; } }
    @keyframes wave-r { 0%, 100% { opacity: 0; transform: none; } 3%, 9% { opacity: .9; } 6%, 12% { opacity: 0; transform: translateX(7px); } 6.01% { transform: none; } }
    @keyframes turn { 0% { opacity: 0; transform: scaleX(1); } 1% { opacity: 1; } 9% { opacity: 1; transform: scaleX(-1); } 10%, 100% { opacity: 0; transform: scaleX(-1); } }
    @keyframes sheen { 0% { opacity: 0; transform: translateX(-150px); } 2% { opacity: 1; } 11% { opacity: 1; transform: translateX(150px); } 12%, 100% { opacity: 0; transform: translateX(150px); } }
    @keyframes nudge { 0%, 7%, 100% { transform: none; } 3.5% { transform: translateX(6px); } }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
  </style>
  <defs>
    <linearGradient id="wash" x2="1">
      <stop stop-color="{{ theme.accent }}" stop-opacity="0.25"/>
      <stop offset="0.72" stop-color="{{ theme.bg }}" stop-opacity="0.02"/>
    </linearGradient>
    <pattern id="fibers" width="24" height="22" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="5" r="0.8" fill="{{ theme.text }}" fill-opacity="0.07"/>
      <circle cx="19" cy="16" r="0.7" fill="{{ theme.accent }}" fill-opacity="0.09"/>
      <path d="M8 19 l6 -1 M1 11 l4 0.5" stroke="{{ theme.text }}" stroke-opacity="0.055"/>
    </pattern>
{%- if cover %}
    <clipPath id="cover"><rect x="36" y="24" width="94" height="128" rx="2"/></clipPath>
    <linearGradient id="sheen" x2="1">
      <stop offset="0.3" stop-color="#fff" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.55"/>
      <stop offset="0.7" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
{%- endif %}
  </defs>
  <rect x="1" y="1" width="{{ layout.width - 2 }}" height="{{ layout.height - 2 }}" rx="8" fill="{{ theme.bg }}" stroke="{{ theme.accent }}" stroke-opacity="0.4" stroke-width="2"/>
  <rect x="2" y="2" width="{{ layout.width - 4 }}" height="{{ layout.height - 4 }}" rx="7" fill="url(#wash)"/>
  <rect x="2" y="2" width="{{ layout.width - 4 }}" height="{{ layout.height - 4 }}" rx="7" fill="url(#fibers)"/>
{% if cover %}
  <rect x="28" y="16" width="108" height="144" rx="6" fill="{{ theme.accent }}" fill-opacity="0.14" stroke="{{ theme.accent }}" stroke-opacity="0.35"/>
  <image x="36" y="24" width="94" height="128" preserveAspectRatio="xMidYMid meet" href="data:{{ cover.mime }};base64,{{ cover.b64 }}"/>
  <g clip-path="url(#cover)" aria-hidden="true">
    <rect x="-20" y="10" width="100" height="160" fill="url(#sheen)" opacity="0" transform="skewX(-14)" style="animation: sheen {{ cycle }} ease-in-out {{ m.sweep }}s {{ m.sweeps }}"/>
  </g>
{% else %}
  <rect x="28" y="26" width="108" height="124" rx="6" fill="{{ theme.accent }}" fill-opacity="0.12" stroke="{{ theme.accent }}" stroke-opacity="0.28"/>
  <g class="icon" transform="translate(82 88)" aria-hidden="true">
{% if key == "writing" %}
    <path d="M-20 -28 H12 L24 -16 V29 H-20Z" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M12 -28 V-16 H24" pathLength="1" style="animation: {{ enter }}"/>
{% for y, x2 in ((-5, 13), (7, 13), (19, 5)) %}
    <path d="M-10 {{ y }} H{{ x2 }}" pathLength="1" style="animation: {{ enter }}, write {{ cycle }} ease-in-out {{ m.sweep + loop.index0 * 0.3 }}s {{ m.sweeps }}"/>
{% endfor %}
{% elif key == "podcast" %}
    <path d="M-25 6 V-3 A25 25 0 0 1 25 -3 V6" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M-25 6 V24 H-13 V4 H-25" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M25 6 V24 H13 V4 H25" pathLength="1" style="animation: {{ enter }}"/>
{% for x, top, bottom in ((-6, 10, 18), (0, 6, 22), (6, 10, 18)) %}
    <path class="fit" d="M{{ x }} {{ top }} V{{ bottom }}" style="animation: {{ land }}, talk {{ cycle }} ease-in-out {{ m.sweep + loop.index0 * 0.12 }}s {{ m.sweeps }}"/>
{% endfor %}
{% elif key == "shipped" %}
    <path d="M-14 -31 V31" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M-14 -22 C-14 -12 16 -18 16 -8 V6 C16 16 -14 12 -14 21" pathLength="1" style="animation: {{ enter }}, write {{ cycle }} ease-in-out {{ m.sweep }}s {{ m.sweeps }}"/>
    <circle class="fit" cx="-14" cy="-29" r="4.5" fill="{{ theme.bg }}" stroke-width="2.5" style="animation: {{ land }}"/>
    <circle class="fit" cx="16" cy="-1" r="4.5" fill="{{ theme.bg }}" stroke-width="2.5" style="animation: {{ land }}"/>
    <circle class="fit" cx="-14" cy="21" r="6" fill="{{ theme.accent }}" stroke="none" opacity="0" style="animation: ring {{ cycle }} ease-out {{ m.sweep + 0.85 }}s {{ m.sweeps }}"/>
    <circle class="fit" cx="-14" cy="21" r="6" fill="{{ theme.accent }}" stroke="none" style="animation: {{ land }}, beat {{ cycle }} ease-in-out {{ m.sweep + 0.8 }}s {{ m.sweeps }}"/>
{% elif key == "stage" %}
    <path d="M-12 -27 H12 V5 A12 12 0 0 1 -12 5Z" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M-23 1 V7 A23 23 0 0 0 23 7 V1" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M0 30 V19 M-12 30 H12" style="animation: {{ enter }}" pathLength="1"/>
    <path d="M-32 -20 Q-39 -8 -32 4" opacity="0" style="animation: wave-l {{ cycle }} ease-out {{ m.sweep }}s {{ m.sweeps }}"/>
    <path d="M32 -20 Q39 -8 32 4" opacity="0" style="animation: wave-r {{ cycle }} ease-out {{ m.sweep }}s {{ m.sweeps }}"/>
{% else %}
    <path d="M0 -24 C-10 -31 -22 -30 -28 -24 V20 C-18 15 -9 16 0 23" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M0 -24 C10 -31 22 -30 28 -24 V20 C18 15 9 16 0 23" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M0 -24 V23" pathLength="1" style="animation: {{ enter }}"/>
    <path d="M0 -24 C10 -31 22 -30 28 -24 V20 C18 15 9 16 0 23 Z" fill="{{ theme.bg }}" stroke-width="2.5" opacity="0" style="transform-box: fill-box; transform-origin: left center; animation: turn {{ cycle }} ease-in-out {{ m.sweep }}s {{ m.sweeps }}"/>
{% endif %}
  </g>
{% endif %}
  <path d="M150 24 V{{ layout.height - 24 }}" stroke="{{ theme.accent }}" stroke-opacity="0.36"/>
  <text x="{{ layout.text_x }}" y="{{ layout.header_y }}" font-family="{{ sans }}" font-size="15" font-weight="700" letter-spacing="2.6" fill="{{ theme.accent }}">{{ header }}</text>
{%- if header_note %}
  <text x="{{ layout.width - 38 }}" y="{{ layout.header_y }}" text-anchor="end" font-family="{{ sans }}" font-size="14" letter-spacing="0.4" fill="{{ theme.muted }}">{{ header_note }}</text>
{%- endif %}
{% for text in layout.primary %}
  <text x="{{ layout.text_x }}" y="{{ layout.title_y[loop.index0] }}" font-family="{{ serif }}" font-size="29" font-weight="700" fill="{{ theme.text }}">{{ text }}</text>
{% endfor %}
  <text x="{{ layout.text_x }}" y="{{ layout.secondary_y }}" font-family="{{ sans }}" font-size="17" letter-spacing="0.6" fill="{{ theme.muted }}">{{ layout.secondary }}</text>
  <g style="animation: nudge {{ cycle }} ease-in-out {{ m.sweep + 0.3 }}s {{ m.sweeps }}">
    <text x="1104" y="94" text-anchor="end" font-family="{{ sans }}" font-size="16" font-weight="700" letter-spacing="2.3" fill="{{ theme.accent }}">{{ action }}</text>
    <path d="M1124 88 H1161 M1150 77 L1161 88 L1150 99" fill="none" stroke="{{ theme.accent }}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
