[Unit]
Description=Refresh the onlydole GitHub profile every six hours

[Timer]
# Half an hour before each scheduled workflow run (17 past 2, 8, 14, 20 UTC),
# so the two rarely race for main.
OnCalendar=*-*-* 01,07,13,19:47:00 UTC
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
